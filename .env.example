# Copy to .env and adjust. docker compose reads this file automatically.
#
#   cp .env.example .env
#
# Every value below is optional: the defaults shown are what the application
# uses when the variable is absent.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL takes precedence over the DB_* variables when it is set, which is
# handy for managed databases:
#   DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
DB_USER=authcli
DB_PASSWORD=authcli
DB_NAME=authcli
DB_SSLMODE=disable
# Only used when running the binary outside compose; inside compose the app
# service points at the db service.
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Encrypts TOTP secrets at rest. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET_KEY=change-me-in-production

# bcrypt work factor. 12 is a good balance on modern hardware; raise it and
# existing hashes get upgraded on the next successful login.
AUTH_BCRYPT_COST=12
AUTH_MIN_PASSWORD_LENGTH=10

# Account lockout: N failed attempts within a window lock the account.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Inactivity timeout, refreshed by every authenticated command.
AUTH_SESSION_TIMEOUT=15m
# Hard ceiling regardless of activity.
AUTH_SESSION_MAX_LIFETIME=8h

# ---------------------------------------------------------------------------
# Two factor authentication
# ---------------------------------------------------------------------------
# Shown as the account issuer in the authenticator app.
AUTH_TOTP_ISSUER=osto-cli-auth
# Accepted clock drift, in 30 second periods.
AUTH_TOTP_SKEW_PERIODS=1
# How long a password verified login waits for the six digit code.
AUTH_TOTP_CHALLENGE_TTL=2m

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
CLI_HISTORY_LIMIT=500
# CLI_HISTORY_FILE=/home/authcli/history/.authcli_history
# Set CLI_COLOR=false (or NO_COLOR=1) for plain output.
CLI_COLOR=true
TZ=UTC
